{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NVM Desktop E2E",
  "identifier": "io.github.1111mp.nvm-desktop.e2e",
  "bundle": {
    "createUpdaterArtifacts": false
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        "default",
        {
          "identifier": "e2e",
          "windows": [
            "main"
          ],
          "permissions": [
            "wdio:default",
            "wdio-webdriver:default"
          ]
        }
      ]
    }
  },
  "build": {
    "beforeBuildCommand": "pnpm exec tsc && pnpm exec vite build --mode e2e"
  }
}
