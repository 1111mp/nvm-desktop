  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "build:verbose": "tauri build --verbose",
    "tauri": "tauri",
    "ui:dev": "vite",
    "ui:build": "tsc && vite build",
    "ui:preview": "vite preview",
    "check": "node scripts/check.mjs",
    "updater": "node scripts/updater.mjs",
    "updater-fixed-webview2": "node scripts/updater-fixed-webview2.mjs",
    "generate:themes": "node scripts/theme-generator.mjs",
    "oxlint": "oxlint src scripts test/e2e wdio.conf.ts vitest.config.ts --type-aware",
    "oxlint:fix": "oxlint src scripts --fix",
    "type-check": "tsc --noEmit -p tsconfig.app.json",
    "format:check": "oxfmt --check src test/e2e wdio.conf.ts vitest.config.ts scripts/e2e.mjs",
    "format:write": "oxfmt --write src test/e2e wdio.conf.ts vitest.config.ts scripts/e2e.mjs",
    "prepare": "husky",
    "test": "vitest run --project unit --project component --project tauri",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:tauri": "vitest run --project tauri",
    "test:browser": "vitest run --project browser",
    "test:watch": "vitest --project unit --project component --project tauri",
    "test:e2e:build": "node scripts/e2e.mjs build",
    "test:e2e": "node scripts/e2e.mjs",
    "type-check:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "set-updater-channel": "node scripts/set-updater-channel.mjs"
  },
